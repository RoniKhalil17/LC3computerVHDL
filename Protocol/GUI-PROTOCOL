                    continue;
                default:
                    System.out.println("Unknown type: " + String.format("0x%02X", type));
                    continue;
            }

            int totalRead = comPort.readBytes(payload, expectedLength);
            if (totalRead < expectedLength) {
                System.out.println("Incomplete payload for type: " + String.format("0x%02X", type));
                continue;
            }

            byte[] fullMessage = new byte[2 + expectedLength];
            fullMessage[0] = HEADER;
            fullMessage[1] = type;
            System.arraycopy(payload, 0, fullMessage, 2, expectedLength);

            switch (type) {
                case (byte) 0x88: handlePlayerData(fullMessage, 1); break;
                case (byte) 0x89: handlePlayerData(fullMessage, 2); break;
                case (byte) 0x87: handlePlayerData(fullMessage, 3); break;
                case (byte) 0x66: handleBet(fullMessage, 1); break;
                case (byte) 0x67: handleBet(fullMessage, 2); break;
                case (byte) 0x68: handleBet(fullMessage, 3); break;
                case (byte) 0x61: handleColor(fullMessage, 1); break;
                case (byte) 0x62: handleColor(fullMessage, 2); break;
                case (byte) 0x63: handleColor(fullMessage, 3); break;
                case (byte) 0x71: handleNum(fullMessage, 1); break;
                case (byte) 0x72: handleNum(fullMessage, 2); break;
                case (byte) 0x73: handleNum(fullMessage, 3); break;
                case (byte) 0x51: handleHistoric(fullMessage);
            }
        }

