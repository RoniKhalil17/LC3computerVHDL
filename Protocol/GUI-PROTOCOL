    private static void handleWheel(SerialPort comPort, JPanel circlePanel) {
        System.out.println("Wheel spin started");

        while (true) {
            byte[] singleByte = new byte[1];
            int read = comPort.readBytes(singleByte, 1);

            if (read > 0) {
                int val = singleByte[0] & 0xFF;

                if (val == STOP_BYTE) {
                    System.out.println("Wheel spin ended.");
                    break;
                }

                System.out.println("Wheel Value: " + val);
                rotateToNumber(val, circlePanel);

