            // Header matched; now read type byte
            byte[] typeBuf = new byte[1];
            if (comPort.readBytes(typeBuf, 1) < 1) continue;
            byte type = typeBuf[0];

            byte[] payload = new byte[12];  // maximum expected size
            int expectedLength = 0;

            switch (type) {
                case (byte) 0x88:   //player data
                case (byte) 0x89:
                case (byte) 0x87:
                    expectedLength = 6; // 3 name + 1 filler + 2 bytes balance
                    break;
                case (byte) 0x66:   //player bets
                case (byte) 0x67:
                case (byte) 0x68:
                    expectedLength = 2; // 2 bytes for bet amount
                    break;
                case (byte) 0x61:   //player color
                case (byte) 0x62:
                case (byte) 0x63:
                    expectedLength = 1; // 1 bytes for color amount
                    break;
                case (byte) 0x71:   //player number bet
                case (byte) 0x72:
                case (byte) 0x73:
                    expectedLength = 1;
                    break;
                case (byte) 0x51:
                    expectedLength = 10;
                    break;
                case (byte) 0x99:   //wheel
