    private static void handlePlayerData(byte[] buffer, int playerId) {
        if (buffer.length < 8) return;

        char name1 = (char) buffer[2];
        char name2 = (char) buffer[3];
        char name3 = (char) buffer[4];
        String name = "" + name1 + name2 + name3;

        int balance = ((buffer[7] & 0xFF) << 8) | (buffer[6] & 0xFF);

        switch (playerId) {
            case 1:
                GUIUART.player1Name = name;
                GUIUART.player1Score = balance;
                break;
            case 2:
                GUIUART.player2Name = name;
                GUIUART.player2Score = balance;
                break;
            case 3:
                GUIUART.player3Name = name;
                GUIUART.player3Score = balance;
                break;
        }

        System.out.printf("Player %d Name: %s, Balance: %d%n", playerId, name, balance);
        updatePlayerName(GUIUART.player1Name, GUIUART.player2Name, GUIUART.player3Name);
        updateSaldo(GUIUART.player1Score, GUIUART.player2Score, GUIUART.player3Score);
    }

    private static void handleBet(byte[] buffer, int playerId) {
        if (buffer.length < 4) return;

        int betAmount = ((buffer[3] & 0xFF) << 8) | (buffer[2] & 0xFF);

        switch (playerId) {
            case 1: GUIUART.player1Bet = betAmount; break;
            case 2: GUIUART.player2Bet = betAmount; break;
            case 3: GUIUART.player3Bet = betAmount; break;
        }

        System.out.printf("Player %d Bet: %d%n", playerId, betAmount);
        updatePlayerBet(GUIUART.player1Bet, GUIUART.player2Bet, GUIUART.player3Bet);
    }

