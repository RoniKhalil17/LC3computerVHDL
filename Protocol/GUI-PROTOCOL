private static void drawSegment(Graphics2D g2d, Color c, int w, int h, int start, int arcSize,
                                    int cx, int cy, int r, int number) {
        g2d.setColor(c);
        g2d.fillArc(50, 50, w, h, start, arcSize);
        drawNumber(g2d, cx, cy, r, start, arcSize, number);
    }

    private static void drawNumber(Graphics2D g2d, int cx, int cy, int r, int startAngle, int arcSize, int number) {
        double midAngle = Math.toRadians(startAngle + arcSize / 2.0);
        int x = (int) (cx + r * Math.cos(-midAngle));
        int y = (int) (cy + r * Math.sin(-midAngle));
        String label = String.valueOf(number);
        FontMetrics fm = g2d.getFontMetrics();
        int w = fm.stringWidth(label);
        int h = fm.getAscent();
        g2d.setColor(Color.WHITE);
        g2d.drawString(label, x - w / 2, y + h / 2);
    }

    // Method to rotate wheel to a given number
    public static void rotateToNumber(int target, JPanel circle) {
        // Each segment is 17 degrees except last which is 20.
        // Simple approach: assume the segment for 'target' starts at (target-1)*17, except #21 is at 20 segments of 17 + 0
        // Adjust offset so that desired segment is at angle 90
        int anglePerSeg = (target <= 20) ? 17 : 20;
        int desiredStart = (target <= 20) ? (target - 1) * 17 : 20 * 17;
        // Adjust rotationOffset so that the target is at 90 degrees (or right).
        rotationOffset = 83 - desiredStart;
        circle.repaint();
    }
    public static void animateRotationToNumber(int target, JPanel circle, int durationMillis) {
        final int startOffset = rotationOffset;
        // Calculate target offset (same logic as rotateToNumber)
        if (target==1) {
            rotateToNumber(target, circle);
        return; // No animation needed for 21, just set it directly
        }
        final int anglePerSeg = (target <= 20) ? 17 : 20;
        final int desiredStart = (target <= 20) ? (target - 1) * 17 : 20 * 17;
        final int endOffset = 83 -desiredStart;
        
        final int steps = 10; // Number 
        final int delay = durationMillis / steps;
        final int offsetDiff = endOffset - startOffset;
    
        Timer timer = new Timer(delay, e -> {
            // Move rotationOffset a fraction of the total distance each tick
            rotationOffset += offsetDiff / steps;
            circle.repaint();
          
            // Stop after final step
            if (Math.abs(rotationOffset - endOffset) < Math.abs(offsetDiff / steps)) {
                rotationOffset = endOffset;
                circle.repaint();
                ((Timer) e.getSource()).stop();
            }
        });
        timer.start();
    }

